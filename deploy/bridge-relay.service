# /etc/systemd/system/bridge-relay.service
[Unit]
Description=Bridge Relay (Bridge Console from the phone)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/cowork-agent/scripts/relay.mjs --name console.hirolab.space --listen 127.0.0.1 --port 8787
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
